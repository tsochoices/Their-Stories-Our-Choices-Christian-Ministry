  src="ministry-logo.jpg"
  alt="Their Stories, Our Choices Christian Ministry logo"
>
        <strong>Their Stories, Our Choices</strong>
        <small>CHRISTIAN PODCAST MINISTRY</small>
      </span>
    </a>
    <button class="menu-toggle" aria-label="Open navigation"
      aria-expanded="false" aria-controls="main-nav">☰</button>
    <nav id="main-nav" class="main-nav" aria-label="Main navigation">
      <a href="index.html">Home</a>
